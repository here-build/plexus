{
  "name": "@here.build/plexus",
  "version": "0.9.3",
  "description": "Reactive state management with automatic replication: make TypeScript classes sync across clients via Yjs CRDT.",
  "keywords": [
    "crdt",
    "yjs",
    "reactive",
    "state-management",
    "collaboration",
    "mobx",
    "real-time"
  ],
  "license": "MIT",
  "author": "here.build",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/here-build/plexus#readme",
  "bugs": {
    "url": "https://github.com/here-build/plexus/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./internals": {
      "types": "./dist/internals.d.ts",
      "import": "./dist/internals.js",
      "require": "./dist/internals.js",
      "default": "./dist/internals.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!**/__tests__",
    "!**/__research__",
    "!**/__benchmarks__",
    "!**/__custdev__",
    "!**/__visual__",
    "!**/*.test.*",
    "!**/*.stories.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --config vitest.config.varianced.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@here.build/arrival-env": "0.9.0",
    "@here.build/collections": "0.9.0",
    "nanoid": "5.1.5",
    "tiny-invariant": "1.3.3",
    "type-fest": "5.4.4"
  },
  "devDependencies": {
    "@here.build/eslint-configs": "0.9.0",
    "@here.build/tsconfig": "0.9.0",
    "@types/node": "24.0.0",
    "@types/ws": "8.18.1",
    "eslint": "9.39.2",
    "fast-check": "4.8.0",
    "lib0": "0.2.114",
    "mobx": "6.15.0",
    "prettier": "3.8.1",
    "tslib": "2.8.1",
    "typescript": "6.0.2",
    "vitest": "4.1.0",
    "ws": "8.18.3",
    "y-protocols": "1.0.6",
    "y-websocket": "3.0.0",
    "yjs": "13.6.30"
  },
  "peerDependencies": {
    "lib0": "0.2.114",
    "mobx": "^6.15.0",
    "y-protocols": "1.0.6",
    "yjs": "^13.6.30"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/plexus.git",
    "directory": "packages/plexus"
  }
}
