{
  "name": "@here.build/plexus-vfs",
  "version": "0.1.0",
  "description": "Plexus-backed virtual filesystem — a drop-in `fs` for isomorphic-git. File content is stored directly as a CRDT-synced `Uint8Array` field, so arbitrary binary round-trips faithfully.",
  "license": "FSL-1.1-MIT",
  "author": "here.build",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fs-client": {
      "types": "./dist/fs-client.d.ts",
      "import": "./dist/fs-client.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@here.build/plexus": "workspace:^"
  },
  "devDependencies": {
    "@here.build/eslint-configs": "workspace:^",
    "@here.build/tsconfig": "workspace:^",
    "@types/node": "24.0.0",
    "eslint": "9.39.2",
    "isomorphic-git": "1.38.5",
    "tslib": "2.8.1",
    "typescript": "6.0.2",
    "vitest": "4.1.0",
    "yjs": "13.6.30"
  }
}
