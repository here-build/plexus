{
  "name": "@here.build/y-messageport",
  "version": "0.1.0",
  "private": true,
  "description": "Yjs sync + awareness provider over MessagePort. One Y.Doc per port. Pair with @here.build/y-control-channel for multi-doc routing.",
  "license": "UNLICENSED",
  "author": "here.build",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "default": "./dist/protocol.js"
    },
    "./mobx": {
      "types": "./dist/mobx.d.ts",
      "import": "./dist/mobx.js",
      "default": "./dist/mobx.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "src/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "visual": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "lib0": "0.2.114"
  },
  "devDependencies": {
    "@here.build/eslint-configs": "workspace:^",
    "@here.build/tsconfig": "workspace:^",
    "@types/node": "24.0.0",
    "eslint": "9.39.2",
    "mobx": "6.15.0",
    "prettier": "3.8.1",
    "tslib": "2.8.1",
    "typescript": "6.0.2",
    "vitest": "4.1.0",
    "y-protocols": "1.0.6",
    "yjs": "13.6.30"
  },
  "peerDependencies": {
    "mobx": "^6.15.0",
    "y-protocols": "1.0.6",
    "yjs": "^13.6.30"
  },
  "peerDependenciesMeta": {
    "mobx": {
      "optional": true
    }
  }
}
