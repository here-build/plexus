{
  "name": "@here.build/plexus-history",
  "version": "0.1.0",
  "private": true,
  "description": "Change-history layer over a gc:false Yjs/Plexus archive. PUBLIC read surface: the lift (changesBetween → PlexusChange[]) + valueAsOf + restore-plan + operators + CutLog query. Server CAPTURE surface (bindCapture/captureCut) at the /capture subpath, wired in LogDO. The live edit-history substrate (distinct from project-git's commit/deploy snapshots); shared by here.build and Inhuman.",
  "license": "UNLICENSED",
  "author": "here.build",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./capture": {
      "types": "./dist/capture.d.ts",
      "import": "./dist/capture.js",
      "default": "./dist/capture.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "src/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@here.build/plexus": "workspace:^"
  },
  "peerDependencies": {
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@here.build/eslint-configs": "workspace:^",
    "@here.build/tsconfig": "workspace:^",
    "@types/node": "24.0.0",
    "eslint": "9.39.2",
    "prettier": "3.8.1",
    "tslib": "2.8.1",
    "typescript": "6.0.2",
    "vitest": "4.1.0",
    "yjs": "13.6.30"
  }
}
