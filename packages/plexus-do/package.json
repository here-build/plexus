{
  "name": "@here.build/plexus-do",
  "version": "0.9.0",
  "description": "Worker draft for Plexus/Yjs sync on Cloudflare Durable Objects — leader, archive follower, presence. Products subclass; authorizeWebSocket is required. No product semantics here.",
  "license": "FSL-1.1-MIT",
  "author": "here.build",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/here-build/plexus#readme",
  "bugs": {
    "url": "https://github.com/here-build/plexus/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/plexus.git",
    "directory": "packages/plexus-do"
  },
  "type": "module",
  "sideEffects": [
    "./dist/errors.js",
    "./dist/index.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./leader": {
      "types": "./dist/leader-sync-do.d.ts",
      "import": "./dist/leader-sync-do.js",
      "default": "./dist/leader-sync-do.js"
    },
    "./archive": {
      "types": "./dist/archive-sync-do.d.ts",
      "import": "./dist/archive-sync-do.js",
      "default": "./dist/archive-sync-do.js"
    },
    "./presence": {
      "types": "./dist/presence/index.d.ts",
      "import": "./dist/presence/index.js",
      "default": "./dist/presence/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "src/**/*",
    "!**/__tests__",
    "!**/__research__",
    "!**/__benchmarks__",
    "!**/__custdev__",
    "!**/__visual__",
    "!**/*.test.*",
    "!**/*.stories.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@here.build/chunked-websocket": "0.9.0",
    "@here.build/error-invariant": "0.9.0",
    "lib0": "0.2.114",
    "y-protocols": "1.0.6",
    "yjs": "13.6.30"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250803.0",
    "@here.build/eslint-configs": "0.9.0",
    "@here.build/tsconfig": "0.9.0",
    "@types/node": "24.0.0",
    "eslint": "9.39.2",
    "tslib": "2.8.1",
    "typescript": "6.0.2",
    "vitest": "4.1.0"
  }
}
