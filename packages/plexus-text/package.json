{
  "name": "@here.build/plexus-text",
  "version": "0.1.0",
  "description": "PlexusText — Peritext-style rich text as a pure Plexus entity sequence: TextAtom + void Marker nodes in a child.list, Marks as owned entities. No Y.Text. Intent ops are @syncing.action methods.",
  "license": "FSL-1.1-MIT",
  "author": "here.build",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bench": {
      "types": "./dist/bench/index.d.ts",
      "import": "./dist/bench/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "benchmarks": "vitest run --config vitest.benchmarks.config.ts"
  },
  "dependencies": {
    "@here.build/plexus": "workspace:^",
    "nanoid": "5.1.5",
    "yjs": "13.6.30",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@here.build/eslint-configs": "workspace:^",
    "@here.build/tsconfig": "workspace:^",
    "eslint": "9.39.2",
    "fast-check": "4.8.0",
    "lib0": "0.2.114",
    "typescript": "6.0.2",
    "vitest": "4.1.0"
  }
}
