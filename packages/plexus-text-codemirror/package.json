{
  "name": "@here.build/plexus-text-codemirror",
  "version": "0.1.0",
  "description": "CodeMirror 6 binding for PlexusText — collaborative plain text, PlexusAwareness carets, liminal peer re-render.",
  "license": "FSL-1.1-MIT",
  "author": "here.build",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "benchmarks": "vitest run --config vitest.benchmarks.config.ts",
    "benchmarks:chromium": "node scripts/chromium-large-bench.mjs"
  },
  "dependencies": {
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.0",
    "@here.build/plexus": "workspace:^",
    "@here.build/plexus-text": "workspace:^",
    "mobx": "6.15.0",
    "yjs": "13.6.30"
  },
  "devDependencies": {
    "@here.build/eslint-configs": "workspace:^",
    "@here.build/tsconfig": "workspace:^",
    "eslint": "9.39.2",
    "jsdom": "26.1.0",
    "lib0": "0.2.114",
    "tslib": "2.8.1",
    "typescript": "6.0.2",
    "vitest": "4.1.0",
    "playwright": "1.52.0",
    "vite": "7.2.7",
    "codemirror": "6.0.2"
  }
}
