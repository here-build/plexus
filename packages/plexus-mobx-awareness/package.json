{
  "name": "@here.build/plexus-mobx-awareness",
  "version": "0.0.0",
  "private": true,
  "description": "MobX reactive lens over PlexusAwareness — share one computed graph with plexus entity fields.",
  "license": "FSL-1.1-MIT",
  "author": "here.build",
  "type": "module",
  "sideEffects": [
    "./dist/register.js",
    "./src/register.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js",
      "default": "./dist/register.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!**/__tests__",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@here.build/collections": "workspace:^",
    "@here.build/plexus": "workspace:^",
    "tiny-invariant": "1.3.3"
  },
  "peerDependencies": {
    "mobx": "^6.15.0"
  },
  "devDependencies": {
    "@here.build/eslint-configs": "workspace:^",
    "@here.build/tsconfig": "workspace:^",
    "@types/node": "24.0.0",
    "eslint": "9.39.2",
    "mobx": "6.15.0",
    "prettier": "3.8.1",
    "tslib": "2.8.1",
    "typescript": "6.0.2",
    "vitest": "4.1.0",
    "yjs": "13.6.30"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/plexus.git",
    "directory": "packages/plexus-mobx-awareness"
  }
}
