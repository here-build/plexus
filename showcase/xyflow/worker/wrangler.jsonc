{
  "name": "plexus-xyflow-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "durable_objects": {
    "bindings": [{ "name": "DOC_LEADER", "class_name": "DocLeader" }],
  },
  "exports": {
    "DocLeader": { "type": "durable-object", "storage": "sqlite" },
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
}
