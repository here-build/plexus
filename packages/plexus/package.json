{
  "name": "@here.build/plexus",
  "version": "0.1.0",
  "description": "Constraint network for object state superposition through mathematical field dynamics",
  "keywords": [
    "constraint",
    "field",
    "mathematics",
    "model",
    "proxy",
    "superposition"
  ],
  "license": "MIT",
  "author": "here.build",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mobx": {
      "types": "./dist/mobx/index.d.ts",
      "import": "./dist/mobx/index.js",
      "require": "./dist/mobx/index.js",
      "default": "./dist/mobx/index.js"
    },
    "./mobx/register": {
      "types": "./dist/mobx/register.d.ts",
      "import": "./dist/mobx/register.js",
      "require": "./dist/mobx/register.js",
      "default": "./dist/mobx/register.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "src/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --config vitest.config.varianced.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@here.build/arrival-env": "workspace:^",
    "@here.build/collections": "workspace:^",
    "lib0": "^0.2.114",
    "nanoid": "^5.1.5",
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@here.build/eslint-configs": "workspace:^",
    "@here.build/tsconfig": "workspace:^",
    "@types/node": "24",
    "eslint": "^9.39.2",
    "fast-check": "^4.5.3",
    "mobx": "^6.15.0",
    "prettier": "^3.8.1",
    "tslib": "^2.8.1",
    "type-fest": "^5.4.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14",
    "yjs": "^13.6.27"
  },
  "peerDependencies": {
    "mobx": "^6.15.0",
    "yjs": "^13.6.27"
  },
  "peerDependenciesMeta": {
    "mobx": {
      "optional": true
    }
  }
}
