{
  "name": "@here.build/plexus-expectation-do",
  "version": "0.0.0",
  "private": true,
  "description": "PEW × Cloudflare Durable Objects — kernel installation, DO-actor relay loader, alarm reconcile. Red-test frontier: surface is typed stubs until the design proposal lands.",
  "license": "FSL-1.1-MIT",
  "author": "here.build",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!**/__tests__",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@here.build/plexus": "workspace:^",
    "@here.build/plexus-expectation": "workspace:^",
    "tiny-invariant": "1.3.3",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@here.build/eslint-configs": "workspace:^",
    "@here.build/tsconfig": "workspace:^",
    "@types/node": "24.0.0",
    "eslint": "9.39.2",
    "prettier": "3.8.1",
    "typescript": "6.0.2",
    "vitest": "4.1.0",
    "yjs": "13.6.30"
  }
}
