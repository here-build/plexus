{
  "name": "@here.build/plexus-xyflow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "xyflow as a view of a Plexus Flow. Same React children; the document is the graph.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./plexus": {
      "types": "./src/XyflowPlexus.ts",
      "import": "./src/XyflowPlexus.ts",
      "default": "./src/XyflowPlexus.ts"
    }
  },
  "files": ["src"],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@here.build/plexus": "workspace:*",
    "@here.build/plexus-xyflow-models": "workspace:*",
    "@xyflow/react": "^12.0.0",
    "mobx": "^6.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@here.build/plexus": "workspace:*",
    "@here.build/plexus-xyflow-models": "workspace:*",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@xyflow/react": "^12.8.2",
    "mobx": "6.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "6.0.2",
    "vitest": "^4.1.0",
    "yjs": "13.6.30"
  }
}
