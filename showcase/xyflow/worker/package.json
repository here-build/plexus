{
  "name": "plexus-xyflow-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Exemplary plexus-do host for the xyflow showcase. First writer of the Flow; browsers only connect.",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "dev": "wrangler dev --port 8788",
    "deploy": "pnpm --filter plexus-xyflow-demo build && rm -rf public && cp -R ../demo/dist public && wrangler deploy",
    "types": "wrangler types",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@here.build/plexus": "workspace:*",
    "@here.build/plexus-do": "workspace:*",
    "@here.build/plexus-xyflow-models": "workspace:*",
    "mobx": "6.15.0",
    "yjs": "13.6.30"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "typescript": "6.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.106.0"
  }
}
