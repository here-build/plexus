    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@here.build/tsconfig": "workspace:^",
    "@types/node": "24",
    "dedent": "^1.6.0",
    "prettier": "^3.6.2",
    "tslib": "^2.8.1",
    "typescript": "5.9",
    "vitest": "^3.2.4",
    "yjs": "^13.6.27"
  }
}
